# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio.

# Stripe — Obtén tus llaves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REEMPLAZA_CON_TU_LLAVE_SECRETA
STRIPE_PUBLISHABLE_KEY=pk_test_REEMPLAZA_CON_TU_LLAVE_PUBLICA

# Webhook — Stripe Dashboard → Developers → Webhooks → tu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REEMPLAZA_CON_TU_SECRETO_DE_WEBHOOK

# URL base del servidor (sin barra al final). En producción usa tu dominio HTTPS.
BASE_URL=http://localhost:3000
PORT=3000
